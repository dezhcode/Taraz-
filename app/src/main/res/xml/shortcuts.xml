<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_sc_minus"
        android:shortcutShortLabel="@string/sc_expense">
        <intent
            android:action="ir.taraz.finance.ADD_EXPENSE"
            android:targetPackage="ir.taraz.finance"
            android:targetClass="com.example.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_sc_plus"
        android:shortcutShortLabel="@string/sc_income">
        <intent
            android:action="ir.taraz.finance.ADD_INCOME"
            android:targetPackage="ir.taraz.finance"
            android:targetClass="com.example.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="voice_entry"
        android:enabled="true"
        android:icon="@drawable/ic_sc_mic"
        android:shortcutShortLabel="@string/sc_voice">
        <intent
            android:action="ir.taraz.finance.VOICE_ENTRY"
            android:targetPackage="ir.taraz.finance"
            android:targetClass="com.example.MainActivity" />
    </shortcut>
</shortcuts>
