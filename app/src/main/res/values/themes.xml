<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- The window the system draws before the app has anything on screen. -->
    <style name="Theme.Taraz.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/taraz_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_taraz_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

</resources>
